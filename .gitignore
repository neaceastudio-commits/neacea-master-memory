# Real import datasets are local staging material and must never be committed.
staging/*.json
!staging/import-v1.schema.json
!staging/import-v1.template.json

# Python test/runtime artifacts.
__pycache__/
*.py[cod]

# Local Auth configuration/session material. Never commit credentials or tokens.
.env
.env.*
!.env.example
*.session

# Node package installation artifacts.
node_modules/
