{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neacea-master-memory.local/schemas/import-v1.schema.json",
  "title": "NEACEA MASTER MEMORY Import V1 staging dataset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "dataset_id",
    "generated_at",
    "source_context",
    "records"
  ],
  "properties": {
    "format_version": {
      "const": "import-v1"
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_context": {
      "const": "CHATGPT_MEMORY"
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "label", "reference"],
      "properties": {
        "type": {
          "enum": [
            "CONVERSATION",
            "DOCUMENT",
            "MANUAL_ENTRY",
            "SYSTEM_APPLICATION",
            "IMPORT"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "reference": {
          "type": ["string", "null"],
          "maxLength": 2000
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "category",
        "type",
        "title",
        "content",
        "status",
        "confidence",
        "sensitivity",
        "source",
        "valid_from",
        "valid_to",
        "project",
        "notes",
        "import_action",
        "supersedes"
      ],
      "properties": {
        "record_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "type": {
          "enum": [
            "FACT",
            "PREFERENCE",
            "DECISION",
            "EVENT",
            "PROJECT_STATE",
            "PROCEDURE",
            "GOAL",
            "NOTE"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100000
        },
        "status": {
          "enum": ["CURRENT", "ARCHIVED", "TO_VERIFY"]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "sensitivity": {
          "enum": ["PUBLIC", "PRIVATE", "CONFIDENTIAL", "HIGHLY_SENSITIVE"]
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "valid_from": {
          "type": ["string", "null"]
        },
        "valid_to": {
          "type": ["string", "null"]
        },
        "project": {
          "type": ["string", "null"],
          "maxLength": 300
        },
        "notes": {
          "type": "string",
          "maxLength": 10000
        },
        "import_action": {
          "enum": ["IMPORT", "REVIEW", "SKIP", "SUPERSEDE"]
        },
        "supersedes": {
          "type": ["string", "null"],
          "maxLength": 200
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
